# --- public URL / TLS ---
# Hostname for nginx and the self-signed certificate. No trailing slash.
DOMAIN=mirror.example.com

# Шляхи всередині контейнера nginx (після ./nginx/certs:/etc/nginx/certs:ro)
TLS_CERT_PATH=/etc/nginx/certs/mirror.crt
TLS_KEY_PATH=/etc/nginx/certs/mirror.key

# --- database ---
POSTGRES_USER=mirror
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=mirror

# --- secrets ---
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
TUSD_HOOK_SECRET=change-me-tusd-secret

# --- misc ---
# Максимальний розмір файлу, байт (5 GiB — ролики для ТВ)
MAX_UPLOAD_BYTES=5368709120

# Таймзона «сьогодні» і слотів розкладу. Календар SPA теж у цій зоні.
TZ=Europe/Kyiv

# Порти хоста: 8066 і 443 → nginx:443.
# Редірект із 80 увімкни в compose рядком "80:80", якщо порт вільний.
